# Code-only repository snapshot. Everything is private unless listed here.
*

!/.gitignore
!/package.json
!/package-lock.json
!/studio.html

!/src/
!/src/**/
!/src/**/*.js
!/src/**/*.json

!/tools/
!/tools/*.js
!/tools/*.py

!/tests/
!/tests/*.test.js
!/tests/*.integration.js

/experiments/

architecture.md


# Never publish credentials, even if an allowlisted directory contains them.
.env
.env.*
*.pem
*.key
credentials.json
service-account*.json
