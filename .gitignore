# Code-only repository snapshot. Everything is private unless listed here.
*

!/.gitignore
!/package.json
!/package-lock.json
!/studio.html

!/src/
!/src/**/
!/src/**/*.js
!/src/**/*.json

!/tools/
!/tools/*.js
!/tools/*.py

!/experiments/
!/experiments/exp002_convolution/
!/experiments/exp002_convolution/studio.html
!/experiments/exp002_convolution/src/
!/experiments/exp002_convolution/src/**/
!/experiments/exp002_convolution/src/**/*.js
!/experiments/exp002_convolution/src/**/*.json
!/experiments/exp002_convolution/tools/
!/experiments/exp002_convolution/tools/*.js
!/experiments/exp002_convolution/tools/*.py

# Never publish credentials, even if an allowlisted directory contains them.
.env
.env.*
*.pem
*.key
credentials.json
service-account*.json
